# Puerto donde corre la API
PORT=4000

# Origen permitido para CORS (la URL de tu frontend)
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los JWT de sesión — generá uno único y largo en producción
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambiar-este-valor-por-uno-unico-y-secreto

# Duración de la sesión del admin
JWT_EXPIRES_IN=12h

# Poné "production" cuando despliegues (activa cookies "Secure" y otras protecciones)
NODE_ENV=development

# Credenciales del primer usuario administrador (solo se usan la primera vez que arranca la app,
# para crear la cuenta si todavía no existe ninguna). Cambiá la contraseña después de tu primer login,
# o usá "npm run seed:admin" para fijar una nueva.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=cambiar-esta-contrasena

# Google Sheets — registro de consultas (opcional, ver README para la guía paso a paso).
# Si dejás estas tres vacías, la app funciona igual: las consultas se guardan en la base de
# datos y aparecen en el panel, simplemente no se copian a ninguna planilla.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Consultas
